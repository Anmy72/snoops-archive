# Copy this file to .env before running the application stack.
# Never commit .env or real credentials.

PIWIGO_URL=http://host.docker.internal:8080
PIWIGO_PUBLIC_URL=http://localhost:8080
PIWIGO_API_KEY_ID=replace-with-piwigo-api-key-id
PIWIGO_API_KEY_SECRET=replace-with-piwigo-api-key-secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BACKEND_PORT=8000
FRONTEND_PORT=3000
